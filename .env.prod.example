# =================================================================
# LifeOS 生产环境配置模板 (Production Environment Template)
# 使用说明：
# 1. 生产部署时，复制本文件为 .env 并填入真实的云数据库连接和高强度随机密钥
# 2. 严禁将含有真实生产密码、Secret 的文件提交到任何代码仓库！
# =================================================================

# -----------------
# 1. 应用运行环境
# -----------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# -----------------
# 2. 生产 MySQL 8.0 数据库配置
# -----------------
# 若使用 Docker Compose，DB_HOST 填写 mysql 容器名；若使用云数据库 RDS，填写对应主机内网地址
DB_HOST=mysql
DB_PORT=3306
DB_NAME=lifeos
DB_USER=lifeos_prod
DB_PASSWORD=YOUR_HIGH_ENTROPY_PRODUCTION_PASSWORD_HERE

# -----------------
# 3. 生产 JWT 核心安全签名密钥 (至少 256 位，推荐使用 openssl rand -base64 32 生成)
# -----------------
JWT_SECRET=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION_SECONDS=86400

# -----------------
# 4. 安全防护与日志管理
# -----------------
# 生产环境默认关闭 Swagger/OpenAPI 在线文档，防止接口暴露
ENABLE_SWAGGER=false

# 生产日志存储绝对路径（容器部署映射到宿主机挂载卷）
LOG_FILE_PATH=/var/log/lifeos/app.log

