# LifeOS Backend Local Environment Configuration
# 复制本文件为 .env 并按需修改变量值

# 数据库连接
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lifeos
DB_USER=root
DB_PASSWORD=your_local_password

# 应用服务端口
SERVER_PORT=8080

# JWT 配置 (阶段 2 使用)
JWT_SECRET=your-256-bit-secret-your-256-bit-secret-key-lifeos
JWT_EXPIRATION_HOURS=24

