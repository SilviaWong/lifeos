# =================================================================
# LifeOS 环境变量配置模板 (开发与测试环境)
# 使用说明：复制本文件为 .env 并在本地按需调整参数，严禁将包含真实凭据的文件提交至 Git 仓库
# =================================================================

# -----------------
# 1. 基础服务配置
# -----------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# -----------------
# 2. MySQL 数据库配置
# -----------------
DB_HOST=localhost
DB_PORT=3307
DB_NAME=lifeos
DB_USER=root
DB_PASSWORD=your_local_password

# -----------------
# 3. JWT 身份认证密钥 (开发默认 256 位，生产必须重置)
# -----------------
JWT_SECRET=lifeos-jwt-secret-key-must-be-at-least-256-bits-long-2026-lifeos-system-key
JWT_EXPIRATION_SECONDS=86400

# -----------------
# 4. 调试与文档
# -----------------
ENABLE_SWAGGER=true
LOG_FILE_PATH=./logs/app.log
